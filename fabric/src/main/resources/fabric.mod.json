{
  "schemaVersion": 1,
  "id": "tardis_refined",
  "version": "${version}",
  "name": "TARDIS Refined",
  "description": "TARDIS: Refined is a Minecraft mod based on the world of Doctor Who that adds a personal, teleporting base to the game.",
  "authors": ["River", "Jeryn99", "Magic Man", "ILikePandas", "Jacob K", "50ap5ud5", "acuadragon100"],
  "contributors": ["Commoble", "Lucraft", "starray1000000", "Monsterwaill", "TheJudge", "LoxiGoose"],
  "contact": {
    "sources": "https://github.com/Whocraft/TardisRefined",
    "issues": "https://github.com/Whocraft/TardisRefined/issues",
    "homepage": "https://github.com/Whocraft/TardisRefined"
  },
  "license": "https://github.com/Whocraft/TardisRefined/blob/mc/1.20.1/LICENSE.MD",
  "icon": "tardis_refined.png",
  "environment": "*",
  "entrypoints": {
    "main": ["whocraft.tardis_refined.fabric.TardisRefinedFabric"],
    "cardinal-components": [
      "whocraft.tardis_refined.common.capability.fabric.TRComponents",
      "whocraft.tardis_refined.common.capability.player.fabric.TardisPlayerComponents"
    ],
    "client": ["whocraft.tardis_refined.fabric.TardisRefinedFabricClient"]
  },
  "mixins": [
    "tardis_refined.mixins.json",
    "tardis_refined-common.mixins.json"
  ],
  "accessWidener": "tardis_refined.accesswidener",
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": ">=0.161.0+26.3",
    "cardinal-components-base": ">=8.1.0",
    "forgeconfigapiport": ">=26.3.1",
    "geckolib": ">=5.5.7"
  },
  "custom": {
    "cardinal-components": [
      "tardis_refined:tardis_data",
      "tardis_refined:tardis_player_info"
    ]
  }
}
